rules_version = '2';

// Agendly: ogni utente legge e scrive solo i propri documenti sotto /users/{uid}.
// Le agende condivise (/agendas/{id}) sono accessibili solo ai membri; si entra
// conoscendo il codice di invito. Tutto il resto è negato.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isNullOrTimestamp(v) {
      return v == null || v is timestamp;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'email', 'timezone', 'notificationsEnabled', 'theme', 'defaultAgendaId', 'createdAt', 'updatedAt'])
        && (!('defaultAgendaId' in d) || d.defaultAgendaId == null || (d.defaultAgendaId is string && d.defaultAgendaId.size() <= 64))
        && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 80))
        && (!('email' in d) || (d.email is string && d.email.size() <= 254))
        && (!('timezone' in d) || (d.timezone is string && d.timezone.size() > 0 && d.timezone.size() <= 64))
        && (!('notificationsEnabled' in d) || d.notificationsEnabled is bool)
        && (!('theme' in d) || d.theme in ['system', 'light', 'dark']);
    }

    function validItem(d) {
      return d.keys().hasOnly([
          'type', 'title', 'description', 'date', 'time', 'timezone', 'startAt', 'category', 'priority',
          'status', 'reminderMinutes', 'remindAt', 'recurrence', 'anchorDate', 'endDate', 'endTime', 'endAt',
          'createdBy', 'createdByName', 'completedAt', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll(['type', 'title', 'date', 'timezone', 'startAt', 'category', 'priority', 'status', 'recurrence'])
        && d.type in ['evento', 'attivita', 'promemoria']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 140
        && (!('description' in d) || (d.description is string && d.description.size() <= 2000))
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('time' in d) || d.time == null || (d.time is string && d.time.matches('^[0-2][0-9]:[0-5][0-9]$')))
        && d.timezone is string && d.timezone.size() > 0 && d.timezone.size() <= 64
        && d.startAt is timestamp
        && d.category in ['lavoro', 'personale', 'famiglia', 'acquisti', 'salute', 'altro']
        && d.priority in ['bassa', 'media', 'alta', 'urgente']
        && d.status in ['da_fare', 'in_corso', 'completato', 'rinviato']
        && d.recurrence in ['none', 'daily', 'weekly', 'monthly']
        && (!('anchorDate' in d) || (d.anchorDate is string && d.anchorDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('endDate' in d) || d.endDate == null
            || (d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && d.endDate >= d.date))
        && (!('endTime' in d) || d.endTime == null || (d.endTime is string && d.endTime.matches('^[0-2][0-9]:[0-5][0-9]$')))
        && (!('endAt' in d) || isNullOrTimestamp(d.endAt))
        && (!('createdBy' in d) || d.createdBy is string)
        && (!('createdByName' in d) || (d.createdByName is string && d.createdByName.size() <= 80))
        && (!('reminderMinutes' in d) || d.reminderMinutes == null
            || (d.reminderMinutes is int && d.reminderMinutes > 0 && d.reminderMinutes <= 525600))
        && (!('remindAt' in d) || isNullOrTimestamp(d.remindAt))
        && (!('completedAt' in d) || isNullOrTimestamp(d.completedAt));
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      allow delete: if isOwner(uid);

      match /items/{itemId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validItem(request.resource.data);
        allow update: if isOwner(uid) && validItem(request.resource.data)
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
        allow delete: if isOwner(uid);
      }

      match /fcmTokens/{tokenId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['token', 'userAgent', 'createdAt', 'lastSeenAt'])
          && request.resource.data.token == tokenId
          && request.resource.data.token is string && request.resource.data.token.size() < 1024;
      }
    }

    function agendaPath(agendaId) {
      return /databases/$(database)/documents/agendas/$(agendaId);
    }

    function isMember(agendaId) {
      return signedIn() && request.auth.uid in get(agendaPath(agendaId)).data.members;
    }

    function validAgenda(d) {
      return d.keys().hasOnly(['name', 'ownerId', 'members', 'memberNames', 'inviteCode', 'joinCode', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.ownerId is string && d.members is list && d.members.size() <= 20 && d.ownerId in d.members
        && d.memberNames is map
        && d.inviteCode is string && d.inviteCode.size() >= 16;
    }

    function onlyOwnMemberEntry(uid) {
      return request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([uid]);
    }

    match /agendas/{agendaId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && validAgenda(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && validAgenda(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          // Il proprietario gestisce nome, membri e link di invito.
          request.auth.uid == resource.data.ownerId
          // Ingresso: ci si aggiunge da soli presentando il codice di invito.
          || (!(request.auth.uid in resource.data.members)
            && request.resource.data.joinCode == resource.data.inviteCode
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'joinCode', 'updatedAt'])
            && onlyOwnMemberEntry(request.auth.uid))
          // Uscita: un membro si rimuove da solo.
          || (request.auth.uid in resource.data.members
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'updatedAt'])
            && onlyOwnMemberEntry(request.auth.uid))
        );
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      match /items/{itemId} {
        allow read, delete: if isMember(agendaId);
        allow create: if isMember(agendaId) && validItem(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(agendaId) && validItem(request.resource.data)
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
      }
    }

    // Anteprima dell'invito: leggibile solo conoscendo il codice (niente elenco).
    match /agendaInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['agendaId', 'name', 'ownerName'])
        && getAfter(agendaPath(request.resource.data.agendaId)).data.ownerId == request.auth.uid
        && getAfter(agendaPath(request.resource.data.agendaId)).data.inviteCode == code;
      allow delete: if signedIn() && get(agendaPath(resource.data.agendaId)).data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
